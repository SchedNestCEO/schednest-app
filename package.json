{
  "name": "schednest-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --ignore-pattern '.engineering-backups/**' --ignore-pattern 'artifacts/**'",
    "typecheck": "npm run clean:next && tsc --noEmit",
    "engineering:verify": "node scripts/verify-engineering-foundation.mjs",
    "quality": "npm run engineering:verify && npm run lint && npm run typecheck && npm run build",
    "lint:engineering": "eslint app/admin/engineering/page.tsx scripts/verify-engineering-foundation.mjs",
    "quality:foundation": "npm run engineering:verify && npm run lint:engineering && npm run typecheck && npm run build",
    "env:validate": "node scripts/validate-env.mjs",
    "migrations:validate": "node scripts/validate-migrations.mjs",
    "routes:validate": "node scripts/validate-routes.mjs",
    "vercel:validate": "node scripts/validate-vercel-config.mjs",
    "lint:budget": "node scripts/lint-budget.mjs",
    "lint:baseline:update": "node scripts/update-lint-baseline.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "deployment:verify": "node scripts/verify-deployment.mjs",
    "sprint2:verify": "node scripts/verify-sprint2.mjs && npm run env:validate && npm run migrations:validate && npm run routes:validate && npm run vercel:validate && npm run lint:engineering && npm run lint:budget",
    "clean:next": "node scripts/clean-next.mjs",
    "sprint3:verify": "node scripts/verify-sprint3.mjs && npm run migrations:validate && npm run routes:validate && npm run lint:budget",
    "lint:performance": "eslint app/admin/performance/page.tsx app/api/admin/performance/route.ts app/lib/admin/performance.ts scripts/verify-sprint3.mjs",
    "sprint4:verify": "node scripts/verify-sprint4.mjs && npm run migrations:validate && npm run routes:validate && npm run lint:budget",
    "lint:load": "eslint app/api/admin/performance/route.ts scripts/verify-sprint4.mjs scripts/ingest-k6-summary.mjs scripts/patch-performance-api.mjs",
    "load:ingest": "node scripts/ingest-k6-summary.mjs",
    "sprint5:verify": "node scripts/verify-sprint5.mjs && npm run migrations:validate && npm run routes:validate && npm run lint:budget"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.16.0",
    "stripe": "^22.3.0",
    "tesseract.js": "^7.0.0",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "supabase": "^2.109.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
